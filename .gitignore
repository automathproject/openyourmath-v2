# ./gitignore

# Fichiers système et IDE
.DS_Store
.vscode/

# Dépendances
node_modules
.pnpm-store

# Fichiers de build SvelteKit
/build
/.svelte-kit
/package

# Fichiers d'environnement (ne jamais versionner les secrets)
.env
.env.*
!.env.example

# Fichiers temporaires de Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Fichiers générés par les scripts ---
# C'est la partie la plus importante. Ils DOIVENT être ignorés par Git.
/data/
/static/artifacts/
/cache/

*.synctex.gz

# Sorties des tests d'interface
/test-results/
/playwright-report/
/blob-report/

# Outillage local Claude Code : configuration du serveur de dev pour l'aperçu
# et permissions propres à la machine. Rien de partageable ici pour l'instant ;
# si un jour on veut versionner un réglage d'équipe, le désigner explicitement.
/.claude/
