# ./gitignore

# Fichiers système et IDE
.DS_Store
.vscode/

# Dépendances
node_modules
.pnpm-store

# Fichiers de build SvelteKit
/build
/.svelte-kit
/package

# Fichiers d'environnement (ne jamais versionner les secrets)
.env
.env.*
!.env.example

# Fichiers temporaires de Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Fichiers générés par les scripts ---
# C'est la partie la plus importante. Ils DOIVENT être ignorés par Git.
/data/
/static/artifacts/
/cache/

*.synctex.gz
