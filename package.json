{
  "name": "openyourmath-v2",
  "version": "2.3.4",
  "private": true,
  "type": "module",
  "_comment_scripts": "Scripts maison pour parser LaTeX et construire la DB avant le build de l'app",
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "check:node": "node scripts/check-node-version.js",
    "predev": "pnpm check:node",
    "prebuild:db": "pnpm check:node",
    "prebuild:content": "pnpm check:node",
    "prebuild:content:full": "pnpm check:node",
    "dev": "PUBLIC_APP_VERSION=$npm_package_version vite dev",
    "dev:full": "pnpm build:content && pnpm dev",
    "build:cache": "node scripts/parse-latex.js content/exercises/ cache/exercises/ --incremental",
    "build:cache:full": "node scripts/parse-latex.js content/exercises/ cache/exercises/",
    "build:mappings": "node scripts/analyze_chapters.js",
    "build:db": "node scripts/build-db.js",
    "build:content": "pnpm build:cache && node scripts/build-db.js",
    "build:tikz": "node scripts/build-tikz.js",
    "check:tex": "node scripts/quality/check-exercise-sources.js",
    "test:tex": "node scripts/quality/check-exercise-sources.js",
    "build:content:full": "node scripts/parse-latex.js content/exercises/ cache/exercises/ && node scripts/build-tikz.js && node scripts/build-db.js",
    "build:app": "PUBLIC_APP_VERSION=$npm_package_version vite build",
    "build": "pnpm build:content && pnpm build:app",
    "preview": "PUBLIC_APP_VERSION=$npm_package_version vite preview",
    "clean": "rm -rf .svelte-kit cache data static/artifacts",
    "reset": "pnpm clean && pnpm build:content:full",
    "build:stats": "echo '📊 Statistics:' && echo \"📝 LaTeX files:\" $(find content/exercises -name '*.tex' | wc -l) && echo \"📄 JSON cache:\" $(find cache/exercises -name '*.json' | wc -l) && echo \"💾 Database:\" $(test -f data/exercises.sqlite && sqlite3 data/exercises.sqlite 'SELECT COUNT(*) FROM exercises;' 2>/dev/null || echo '0') 'exercises'",
    "authors:add-exo7-license": "node scripts/update-authors-licenses.js",
    "index:exercises": "node scripts/index-exercises.js",
    "index:exercises:force": "node scripts/index-exercises.js --force",
    "cache:embeddings:restore": "node scripts/ia/restore-embedding-cache.js",
    "cache:embeddings:stats": "node scripts/ia/cache-stats.js",
    "cache:embeddings:check": "node scripts/ia/cache-stats.js --verbose",
    "test": "vitest",
    "test:build": "vitest run tests/build/",
    "test:integration": "playwright test",
    "docker:build": "docker build -t ghcr.io/automathproject/openyourmath:$npm_package_version .",
    "docker:push": "docker push ghcr.io/automathproject/openyourmath:$npm_package_version",
    "docker:release": "pnpm docker:build && pnpm docker:push",
    "docker:dev": "APP_VERSION=$npm_package_version docker compose up",
    "docker:prod": "APP_VERSION=$npm_package_version docker compose up -d"
  },
  "_comment_devDependencies": "SvelteKit + Tailwind + Vite + tests",
  "devDependencies": {
    "@openai/codex": "^0.36.0",
    "@playwright/test": "^1.48.2",
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/kit": "^2.7.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.3",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "postcss": "^8.4.49",
    "svelte": "^5.14.3",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19",
    "vitest": "^2.1.8"
  },
  "_comment_dependencies": "Runtime deps (SQLite + KaTeX)",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "katex": "^0.16.22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@10.33.1"
}
