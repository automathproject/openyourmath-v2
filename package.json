{
  "name": "openyourmath-v2",
  "version": "2.4.5",
  "private": true,
  "type": "module",
  "_comment_scripts": "Scripts maison pour parser LaTeX et construire la DB avant le build de l'app",
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "check:node": "node scripts/check-node-version.js",
    "predev": "pnpm check:node",
    "prebuild:db": "pnpm check:node",
    "prebuild:content": "pnpm check:node",
    "prebuild:content:full": "pnpm check:node",
    "dev": "PUBLIC_APP_VERSION=$npm_package_version vite dev",
    "dev:full": "pnpm build:content && pnpm dev",
    "build:cache": "node scripts/parse-latex.js content/exercises/ cache/exercises/ --incremental",
    "build:cache:full": "node scripts/parse-latex.js content/exercises/ cache/exercises/",
    "build:mappings": "node scripts/analyze_chapters.js",
    "build:db": "node scripts/build-db.js",
    "build:fiches": "node scripts/build-fiches.js",
    "check:fiches": "node scripts/build-fiches.js --check",
    "build:content": "pnpm build:content:incremental",
    "build:content:incremental": "pnpm build:cache && pnpm build:db && pnpm build:fiches",
    "build:content:incremental:with-tikz": "pnpm build:cache && pnpm build:tikz && pnpm build:db && pnpm build:fiches",
    "build:tikz": "node scripts/build-tikz.js",
    "check:tex": "node scripts/quality/check-exercise-sources.js",
    "check:artifacts": "node scripts/quality/check-artifacts.js",
    "test:tex": "node scripts/quality/check-exercise-sources.js",
    "fix:tex:det": "node scripts/quality/fix-exercise-sources-deterministic.js",
    "fix:tex:albert": "node scripts/quality/fix-exercise-sources-with-albert.js",
    "fix:tex:ollama": "node scripts/quality/fix-exercise-sources-with-ollama.js",
    "test:tex:ollama": "vitest run tests/build/fix-exercise-sources-with-ollama.test.js",
    "build:content:full": "pnpm build:cache:full && pnpm build:tikz && pnpm build:db && pnpm build:fiches",
    "build:app": "PUBLIC_APP_VERSION=$npm_package_version vite build",
    "build": "pnpm build:content && pnpm build:app",
    "preview": "PUBLIC_APP_VERSION=$npm_package_version vite preview",
    "clean": "rm -rf .svelte-kit cache data static/artifacts",
    "reset": "pnpm clean && pnpm build:content:full",
    "build:stats": "echo '📊 Statistics:' && echo \"📝 LaTeX files:\" $(find content/exercises -name '*.tex' | wc -l) && echo \"📄 JSON cache:\" $(find cache/exercises -name '*.json' | wc -l) && echo \"💾 Database:\" $(test -f data/exercises.sqlite && sqlite3 data/exercises.sqlite 'SELECT COUNT(*) FROM exercises;' 2>/dev/null || echo '0') 'exercises'",
    "sync:exobase": "node scripts/sync-exobase.js",
    "sync:exobase:check": "node scripts/sync-exobase.js --check",
    "sync:exobase:push": "node scripts/sync-exobase.js --push",
    "authors:add-exo7-license": "node scripts/update-authors-licenses.js",
    "index:exercises": "node scripts/index-exercises.js",
    "index:exercises:force": "node scripts/index-exercises.js --force",
    "exercise:prepare": "node scripts/prepare-exercise.js",
    "exercises:prepare": "node scripts/prepare-new-exercises.js",
    "release:content": "node scripts/release-content.js",
    "release:content:check": "node scripts/release-content.js --check",
    "cache:embeddings:restore": "node scripts/ia/restore-embedding-cache.js",
    "cache:embeddings:stats": "node scripts/ia/cache-stats.js",
    "cache:embeddings:check": "node scripts/ia/cache-stats.js --verbose",
    "db:snapshot:pack": "node scripts/ia/db-snapshot.js pack",
    "db:snapshot:publish": "node scripts/ia/db-snapshot.js publish",
    "db:snapshot:download": "node scripts/ia/db-snapshot.js download",
    "db:snapshot:restore": "node scripts/ia/db-snapshot.js restore && pnpm cache:embeddings:restore",
    "db:snapshot:update": "pnpm db:snapshot:download && pnpm db:snapshot:restore",
    "test": "vitest",
    "test:build": "vitest run tests/build/",
    "test:integration": "playwright test",
    "docker:build": "docker build -t ghcr.io/automathproject/openyourmath:$npm_package_version .",
    "docker:push": "docker push ghcr.io/automathproject/openyourmath:$npm_package_version",
    "docker:release": "pnpm docker:build && pnpm docker:push",
    "docker:dev": "APP_VERSION=$npm_package_version docker compose up",
    "docker:prod": "APP_VERSION=$npm_package_version docker compose up -d",
    "sync:app-version": "node scripts/sync-app-version.js",
    "deploy:server": "pnpm sync:app-version && docker compose pull app && docker compose up -d app && docker compose ps",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown ."
  },
  "_comment_devDependencies": "SvelteKit + Tailwind + Vite + tests",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.1",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.6.1",
    "dotenv": "^18.0.2",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "svelte": "^5.57.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "_comment_dependencies": "Seuls les paquets non bundlés par Vite, donc résolus à l'exécution par build/server (les autres sont en devDependencies)",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "katex": "^0.18.7",
    "qrcode": "^1.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@10.33.1"
}
